./hst1pass.xOg HMIN=5 FMIN=25 PSF=PSFSTD_WFC3UV_F606W.fits GDC=STDGDC_WFC3UV_F606W.fits SHOW_REF- SHOW_SUB+ OUT=xympquvwrd REG=uv PERT=1 ../00.DATA/F606W/*_flc.fits
for f in *.xympquvwrd; do [ -e "$f" ] && mv "$f" "${f%.xympquvwrd}.F606W_xympquvwrd"; done
./hst1pass.xOg HMIN=5 FMIN=25 PSF=PSFSTD_WFC3UV_F814W.fits GDC=STDGDC_WFC3UV_F814W.fits SHOW_REF+ SHOW_SUB+ OUT=xympquvwrd REG=uv PERT=1 ../00.DATA/F814W/*_flc.fits
