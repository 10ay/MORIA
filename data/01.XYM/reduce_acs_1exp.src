./hst1pass.xOg HMIN=5 FMIN=25 PSF=STDPSF_ACSWFC_F606W_SM4.fits GDC=STDGDC_OFFICIAL_JFRAME_ACSWFC_F606W.fits SHOW_REF- SHOW_SUB+ OUT=xympquvwrd REG=uv PERT=1 ../00.DATA/F606W/*_flc.fits
for f in *.xympquvwrd; do [ -e "$f" ] && mv "$f" "${f%.xympquvwrd}.F606W_xympquvwrd"; done
